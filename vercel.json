{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "installCommand": "npm install",
  "framework": "create-react-app",
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/",
      "destination": "/blog/index.html"
    },
    {
      "source": "/data-analytics",
      "destination": "/data-analytics/index.html"
    },
    {
      "source": "/data-analytics/",
      "destination": "/data-analytics/index.html"
    },
    {
      "source": "/business-planning",
      "destination": "/business-planning/index.html"
    },
    {
      "source": "/business-planning/",
      "destination": "/business-planning/index.html"
    },
    {
      "source": "/follow-the-ai-money",
      "destination": "/follow-the-ai-money/index.html"
    },
    {
      "source": "/follow-the-ai-money/",
      "destination": "/follow-the-ai-money/index.html"
    },
    {
      "source": "/ai-tools",
      "destination": "/ai-tools/index.html"
    },
    {
      "source": "/ai-tools/",
      "destination": "/ai-tools/index.html"
    },
    {
      "source": "/ai-agents-2026",
      "destination": "/ai-agents-2026/index.html"
    },
    {
      "source": "/ai-agents-2026/",
      "destination": "/ai-agents-2026/index.html"
    },
    {
      "source": "/inside-sales-guide",
      "destination": "/inside-sales-guide/index.html"
    },
    {
      "source": "/inside-sales-guide/",
      "destination": "/inside-sales-guide/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
